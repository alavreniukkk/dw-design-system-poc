{
  "name": "dw-design-system-poc",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "tokens": "node scripts/figma/tokens-to-css.mjs",
